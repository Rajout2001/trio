FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY pom.xml pom.xml
COPY trio-api/pom.xml trio-api/pom.xml
COPY trio-api/.mvn trio-api/.mvn
COPY trio-api/mvnw trio-api/mvnw
COPY trio-api/mvnw.cmd trio-api/mvnw.cmd

RUN mvn -f trio-api/pom.xml -DskipTests dependency:go-offline

COPY trio-api/src trio-api/src

RUN mvn -f trio-api/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /workspace/trio-api/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java","-jar","/app/app.jar"]
