FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY pom.xml pom.xml
COPY trio-web/pom.xml trio-web/pom.xml

RUN mvn -f trio-web/pom.xml -DskipTests dependency:go-offline

COPY trio-web/src trio-web/src

RUN mvn -f trio-web/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app

COPY --from=build /workspace/trio-web/target/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java","-jar","/app/app.jar"]
